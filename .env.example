# WDK wallet configuration
# Never commit a real seed phrase. Use a dedicated demo/test wallet only.
WDK_SEED_PHRASE="replace with demo wallet seed phrase"
WDK_ACCOUNT_INDEX=0

# RPC endpoints used by the WDK wallet modules.
WDK_ETHEREUM_RPC_URL="https://eth.drpc.org"
WDK_TRON_RPC_URL="https://api.trongrid.io"
WDK_SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"
